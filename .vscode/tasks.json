{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Agent: REPL",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\run-agent.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Run Task",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\run-agent.cmd"
      },
      "args": [
        "run",
        "${input:agentTask}",
        "--profile",
        "${input:agentProfile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Run Task (Offline Strict)",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\run-agent.cmd"
      },
      "args": [
        "run",
        "${input:agentTask}",
        "--profile",
        "${input:agentProfile}",
        "--offline-strict",
        "--config",
        "${workspaceFolder}/config/corporate.offline.config.json"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Install User Command",
      "type": "process",
      "command": "${workspaceFolder}/scripts/install-user-command.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\install-user-command.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Doctor",
      "type": "process",
      "command": "${workspaceFolder}/scripts/run-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\run-agent.cmd"
      },
      "args": [
        "doctor"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Build",
      "type": "process",
      "command": "${workspaceFolder}/scripts/build-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\build-agent.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Agent: Tests",
      "type": "process",
      "command": "${workspaceFolder}/scripts/test-agent.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\test-agent.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Agent: Publish Windows Bundle",
      "type": "process",
      "command": "${workspaceFolder}/scripts/publish-win-x64.sh",
      "windows": {
        "command": "${workspaceFolder}\\scripts\\publish-win-x64.cmd"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "agentTask",
      "type": "promptString",
      "description": "Task for the agent (one-shot mode)",
      "default": "Inspect workspace and summarize current project status."
    },
    {
      "id": "agentProfile",
      "type": "pickString",
      "description": "Model profile",
      "options": [
        "reasoning",
        "fast",
        "fallback"
      ],
      "default": "reasoning"
    }
  ]
}
