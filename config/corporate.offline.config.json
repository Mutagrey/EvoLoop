{
  "api": {
    "baseUrl": "https://YOUR-GATEWAY-HOST",
    "openAiCompatiblePath": "/v1/chat/completions",
    "customPath": "/api/chat",
    "apiKeyEnvVar": "EVOLOOP_API_KEY",
    "timeoutSeconds": 120
  },
  "models": {
    "reasoning": {
      "provider": "custom",
      "model": "deepseek",
      "temperature": 0.12,
      "maxTokens": 2200,
      "toolCallingMode": "JsonReActFallback"
    }
  },
  "safety": {
    "offlineStrictMode": true,
    "defaultApprovalMode": "WorkspaceWrite",
    "allowedNetworkHosts": [
      "YOUR-GATEWAY-HOST"
    ]
  },
  "ui": {
    "useColor": true,
    "compactMode": false
  }
}
