{
  "api": {
    "baseUrl": "https://YOUR-GATEWAY-HOST",
    "openAiCompatiblePath": "/v1/chat/completions",
    "customPath": "/api/chat",
    "preferJsonResponseFormat": true,
    "responseFormatFallbackWithoutJson": true,
    "systemPromptMode": "user",
    "systemPromptFallbackToUserMessage": true,
    "apiKey": "",
    "apiKeyEnvVar": "EVOLOOP_API_KEY",
    "timeoutSeconds": 120,
    "headers": {}
  },
  "models": {
    "reasoning": {
      "provider": "custom",
      "model": "deepseek",
      "temperature": 0.15,
      "maxTokens": 1800
    },
    "fast": {
      "provider": "custom",
      "model": "qwen",
      "temperature": 0.1,
      "maxTokens": 900
    },
    "fallback": {
      "provider": "custom",
      "model": "glm",
      "temperature": 0.2,
      "maxTokens": 1200
    }
  },
  "workspace": {
    "defaultRoot": ".",
    "ignoreGlobs": [
      "bin/**",
      "obj/**",
      ".git/**"
    ]
  },
  "safety": {
    "requireApprovalForWrites": true,
    "requireApprovalForCommits": true,
    "requireApprovalForRiskyShell": true,
    "denyOutsideWorkspace": true,
    "offlineStrictMode": true,
    "allowedNetworkHosts": [
      "YOUR-GATEWAY-HOST"
    ],
    "deniedShellPatterns": [
      "rm -rf /",
      "rm -rf",
      "del /f /s /q",
      "rmdir /s /q",
      "mkfs",
      "dd if=",
      "shutdown",
      "reboot",
      "git reset --hard",
      "git clean -fd",
      "curl",
      "wget",
      "scp",
      "ssh"
    ]
  },
  "runtime": {
    "maxSteps": 30,
    "maxInvalidModelResponses": 4,
    "maxConsecutiveFinalWithoutTools": 4,
    "invalidResponsesBeforeProfileSwitch": 2,
    "finalWithoutToolsBeforeProfileSwitch": 2,
    "toolTimeoutSeconds": 120,
    "maxOutputBytes": 65536,
    "modelMinOutputTokens": 256,
    "modelMaxOutputTokens": 4096,
    "modelMinTemperature": 0.0,
    "modelMaxTemperature": 0.7,
    "lexicalSearchDefaultMaxResults": 20,
    "rerankCandidateLimit": 12
  },
  "ui": {
    "useColor": true,
    "compactMode": false
  }
}
